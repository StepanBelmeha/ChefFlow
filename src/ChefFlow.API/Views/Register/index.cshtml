<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вхід / Реєстрація — ChefFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/auth_page.css">
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#" class="logo">Chef<span>F</span>low</a>
  <ul class="nav-links">
    <li><a href="#">Рецепти</a></li>
    <li><a href="#">Колекції</a></li>
    <li><a href="#">Кухні</a></li>
    <li><a href="#">Про нас</a></li>
  </ul>
</nav>

<!-- MAIN -->
<div class="auth-wrapper">

  <!-- LEFT PANEL -->


  <!-- RIGHT PANEL -->
  <div class="auth-right">
    <div class="auth-form-box">

      <!-- LOGIN -->
      <div class="form-panel active" id="panel-login">
        <h2 class="form-title">З поверненням, <em>кухарю</em></h2>
        <p class="form-subtitle">Введіть свої дані, щоб продовжити готувати</p>

        <div class="form-group">
          <label class="form-label">Email</label>
          <div class="form-input-wrap">
            <input type="email" class="form-input" id="login-email" placeholder="your@email.com">
          </div>
        </div>
        <div class="form-error" id="login-email-error"></div>

        <div class="form-group">
          <label class="form-label">Пароль</label>
          <div class="form-input-wrap">
            <input type="password" class="form-input" id="login-pass" placeholder="••••••••" style="padding-right:48px;">
            <button class="input-icon" onclick="togglePass('login-pass', this)">👁</button>
          </div>
        </div>
        <div class="form-error" id="login-password-error"></div>
        <div class="form-error" id="login-general-error"></div>
        <div class="form-extras">
          <a href="#" class="form-link">Забули пароль?</a>
        </div>

        <button class="form-submit">Увійти →</button>

        <p class="switch-text">
          Ще немає акаунту?
          <a href="#" class="switch-link" onclick="switchPanel('register'); return false;">Зареєструватись</a>
        </p>
      </div>

      <!-- REGISTER -->
      <div class="form-panel" id="panel-register">
        <h2 class="form-title">Створіть <em>акаунт</em></h2>
        <p class="form-subtitle">Приєднайтесь до спільноти тисяч кухарів</p>

        <div class="form-group">
          <label class="form-label">Ім'я</label>
          <input type="text" class="form-input" id="reg-name" placeholder="Оксана">
        </div>
        <div class="form-error" id="reg-name-error"></div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" class="form-input" id="reg-email" placeholder="your@email.com">
        </div>
        <div class="form-error" id="reg-email-error"></div>

        <div class="form-group">
          <label class="form-label">Пароль</label>
          <div class="form-input-wrap">
            <input type="password" class="form-input" id="reg-pass" placeholder="Мінімум 8 символів" style="padding-right:48px;">
            <button class="input-icon" onclick="togglePass('reg-pass', this)">👁</button>
          </div>
        </div>
        <div class="form-error" id="reg-passw-error"></div>
        <div class="form-error" id="reg-general-error"></div>
        <label class="form-check">
          <input type="checkbox">
          <div class="check-box"></div>
        </label>

        <button class="form-submit">Зареєструватись →</button>

        <p class="switch-text">
          Вже маєте акаунт?
          <a href="#" class="switch-link" onclick="switchPanel('login'); return false;">Авторизуйтесь</a>
        </p>
      </div>

    </div>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="footer-logo">Che<span>F</span>low</div>
  <span class="footer-copy">© 2025 ChefFlow. Всі права захищено.</span>
  <div class="footer-links">
    <a href="#">Конфіденційність</a>
    <a href="#">Умови</a>
    <a href="#">Підтримка</a>
  </div>
</footer>

<script src="/js/auth_page.js"></script>
</body>
</html>